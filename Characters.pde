// =====================================================
// FOX
// =====================================================

class Fox {

  float x;
  float y;

  float radius = 10;
  float speed = 3.8;

  float walkTime = 0;
  float facing = 1;


  Fox(float x, float y) {

    this.x = x;
    this.y = y;
  }


  // ===================================================
  // RESET
  // ===================================================

  void reset(float newX, float newY) {

    x = newX;
    y = newY;

    walkTime = 0;
    facing = 1;
  }


  // ===================================================
  // UPDATE
  // ===================================================

  void update() {

    if (
      handPos.x < 0 ||
      handPos.y < 0
    ) {
      return;
    }


    // Centro de control de la mano
    float centerX = width / 2.0;
    float centerY = height / 2.0;


    float dx =
      handPos.x - centerX;

    float dy =
      handPos.y - centerY;


    // Zona muerta
    float deadZone = 35;


    if (abs(dx) < deadZone) {
      dx = 0;
    }

    if (abs(dy) < deadZone) {
      dy = 0;
    }


    // Movimiento
    if (
      dx != 0 ||
      dy != 0
    ) {

      PVector direction =
        new PVector(dx, dy);

      direction.normalize();


      float moveX =
        direction.x * speed;

      float moveY =
        direction.y * speed;


      // Dirección visual
      if (abs(moveX) > 0.1) {

        if (moveX > 0) {
          facing = 1;
        } else {
          facing = -1;
        }
      }


      // Movimiento horizontal
      float newX =
        x + moveX;


      if (
        !maze.collides(
          newX,
          y,
          radius
        )
      ) {

        x = newX;
      }


      // Movimiento vertical
      float newY =
        y + moveY;


      if (
        !maze.collides(
          x,
          newY,
          radius
        )
      ) {

        y = newY;
      }


      walkTime += 0.18;
    }


    // Límites generales
    x = constrain(
      x,
      40 + radius,
      width - 40 - radius
    );


    y = constrain(
      y,
      70 + radius,
      height - 70 - radius
    );
  }


  // ===================================================
  // DRAW
  // ===================================================

  void draw() {

    pushMatrix();

    translate(
      x,
      y
    );


    float bob = 0;


    if (
      handPos.x >= 0 &&
      handPos.y >= 0
    ) {

      bob =
        sin(walkTime) * 1.5;
    }


    translate(
      0,
      bob
    );


    scale(
      facing,
      1
    );


    // =================================================
    // SOMBRA
    // =================================================

    noStroke();

    fill(
      60,
      40,
      30,
      55
    );

    ellipse(
      0,
      14,
      25,
      7
    );


    // =================================================
    // COLA
    // =================================================

    pushMatrix();

    translate(
      11,
      3
    );

    rotate(
      -0.25
    );


    fill(
      210,
      95,
      40
    );

    ellipse(
      0,
      0,
      22,
      14
    );


    // Punta blanca
    fill(
      255,
      235,
      205
    );

    ellipse(
      8,
      0,
      9,
      10
    );


    popMatrix();


    // =================================================
    // CUERPO
    // =================================================

    fill(
      215,
      105,
      45
    );

    ellipse(
      0,
      5,
      25,
      21
    );


    // =================================================
    // PECHO
    // =================================================

    fill(
      255,
      225,
      185
    );

    ellipse(
      0,
      8,
      13,
      14
    );


    // =================================================
    // CABEZA
    // =================================================

    fill(
      230,
      120,
      55
    );

    ellipse(
      0,
      -9,
      28,
      27
    );


    // =================================================
    // OREJAS
    // =================================================

    fill(
      190,
      75,
      35
    );


    triangle(
      -12,
      -17,
      -10,
      -32,
      -2,
      -20
    );


    triangle(
      12,
      -17,
      10,
      -32,
      2,
      -20
    );


    // Interior
    fill(
      255,
      175,
      150
    );


    triangle(
      -10,
      -20,
      -9,
      -28,
      -5,
      -21
    );


    triangle(
      10,
      -20,
      9,
      -28,
      5,
      -21
    );


    // =================================================
    // CARA
    // =================================================

    fill(
      255,
      225,
      190
    );

    ellipse(
      0,
      -5,
      20,
      15
    );


    // =================================================
    // OJOS
    // =================================================

    fill(35);

    ellipse(
      -5,
      -10,
      4,
      5
    );

    ellipse(
      5,
      -10,
      4,
      5
    );


    // Brillos
    fill(255);

    ellipse(
      -4.3,
      -11,
      1.5,
      1.5
    );

    ellipse(
      5.7,
      -11,
      1.5,
      1.5
    );


    // =================================================
    // HOCICO
    // =================================================

    fill(
      255,
      220,
      180
    );

    ellipse(
      0,
      -4,
      13,
      9
    );


    // =================================================
    // NARIZ
    // =================================================

    fill(45);

    ellipse(
      0,
      -6,
      4.5,
      3.5
    );


    // =================================================
    // PATAS
    // =================================================

    fill(
      190,
      80,
      35
    );

    ellipse(
      -7,
      15,
      6,
      4
    );

    ellipse(
      7,
      15,
      6,
      4
    );


    popMatrix();
  }
}



// =====================================================
// ROSE
// =====================================================

class Rose {

  float x;
  float y;

  float scale = 1;

  float pulse = 0;


  Rose(
    float x,
    float y
  ) {

    this.x = x;
    this.y = y;
  }


  // ===================================================
  // CAMBIAR POSICIÓN
  // ===================================================

  void setPosition(
    float newX,
    float newY
  ) {

    x = newX;
    y = newY;
  }


  // ===================================================
  // DRAW
  // ===================================================

  void draw() {

    pulse += 0.06;


    float glow =
      1.0 + sin(pulse) * 0.08;


    pushMatrix();

    translate(
      x,
      y
    );

    scale(
      scale * glow
    );


    // =================================================
    // BRILLO
    // =================================================

    noStroke();

    fill(
      255,
      190,
      80,
      35
    );

    ellipse(
      0,
      5,
      75,
      75
    );


    // =================================================
    // TALLO
    // =================================================

    stroke(
      55,
      130,
      65
    );

    strokeWeight(5);

    line(
      0,
      15,
      0,
      65
    );


    // =================================================
    // HOJAS
    // =================================================

    noStroke();

    fill(
      65,
      145,
      70
    );

    ellipse(
      -14,
      42,
      25,
      11
    );

    ellipse(
      14,
      52,
      25,
      11
    );


    // =================================================
    // PÉTALOS
    // =================================================

    fill(
      195,
      50,
      70
    );

    ellipse(
      0,
      5,
      35,
      35
    );

    ellipse(
      -12,
      8,
      24,
      24
    );

    ellipse(
      12,
      8,
      24,
      24
    );

    ellipse(
      0,
      -7,
      25,
      25
    );


    // =================================================
    // CENTRO
    // =================================================

    fill(
      245,
      170,
      70
    );

    ellipse(
      0,
      5,
      9,
      9
    );


    popMatrix();
  }
}
